# ─────────────────────────────────────────────────────────────
# AI GRC Platform — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงก่อน pnpm dev
# ─────────────────────────────────────────────────────────────

# ── Anthropic Claude AI ──────────────────────────────────────
# ใช้สำหรับ AI features ทุกตัว (drill generation, policy draft, risk analysis)
# สร้างได้ที่: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ─────────────────────────────────────────────────
# ใช้สำหรับ Authentication (Login, Session)
# ดูค่าได้ที่: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App URL ──────────────────────────────────────────────────
# ใช้สำหรับ redirect หลัง auth (email confirmation, password reset)
# local dev ใช้ http://localhost:3000
# production ใช้ https://aigrc-assessment-dashboard.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
